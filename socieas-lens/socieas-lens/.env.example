# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mock mode renders every dashboard with demo data and requires zero keys.
NEXT_PUBLIC_MOCK_MODE=true

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Token encryption (32 byte hex) for stored OAuth tokens ---
TOKEN_ENCRYPTION_KEY=

# --- Google (GA4, Search Console, YouTube) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta (Instagram + Facebook, requires app review) ---
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn (requires Community Management API approval) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- AI narration (Phase 2) ---
OPENAI_API_KEY=

# --- Email (Resend, already used on socieas.com) ---
RESEND_API_KEY=

# --- Cron protection for /api/sync ---
CRON_SECRET=
